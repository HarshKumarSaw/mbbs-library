{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Harsh's Library – MBBS Study Resources",
  "short_name": "Harsh's Library",
  "description": "A free collection of MBBS study materials, notes, textbooks and PDFs, organised for easy access.",
  "id": "/mbbs-library/",
  "start_url": "/mbbs-library/",
  "scope": "/mbbs-library/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#FAF8F4",
  "theme_color": "#FAF8F4",
  "lang": "en-IN",
  "dir": "ltr",
  "categories": [
    "education",
    "medical",
    "books"
  ],
  "icons": [
    {
      "src": "/mbbs-library/assets/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/mbbs-library/assets/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/mbbs-library/assets/icons/icon-maskable-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/mbbs-library/assets/icons/icon-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Anatomy Department",
      "short_name": "Anatomy",
      "description": "Gross anatomy, histology slides, neuroanatomy and embryology notes",
      "url": "/mbbs-library/anatomy.html",
      "icons": [
        {
          "src": "/mbbs-library/assets/icons/icon-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Physiology Department",
      "short_name": "Physiology",
      "description": "Cardiovascular, respiratory, hematology and clinical cases",
      "url": "/mbbs-library/physiology.html",
      "icons": [
        {
          "src": "/mbbs-library/assets/icons/icon-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Biochemistry Department",
      "short_name": "Biochemistry",
      "description": "Metabolic pathways, genetics and clinical enzymology",
      "url": "/mbbs-library/biochemistry.html",
      "icons": [
        {
          "src": "/mbbs-library/assets/icons/icon-192x192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
