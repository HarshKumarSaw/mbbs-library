<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_logo" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Harsh\'s Library • GMC Jagdalpur"
            android:textColor="@color/text_headline"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_widget_refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Refresh Timetable"
            android:padding="4dp"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>

    <!-- Main Card Body (Clickable -> Opens Timetable) -->
    <LinearLayout
        android:id="@+id/card_class_info"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="@color/widget_card_inner"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_active"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="@string/status_happening_now"
                android:textColor="@color/badge_active_text"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_class_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="--:-- - --:--"
                android:textColor="@color/text_subtle"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_class_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Loading Timetable..."
            android:textColor="@color/text_headline"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_class_faculty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="GMC Academic Schedule"
            android:textColor="@color/text_faculty"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Quick Navigation Pills -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_nav_timetable"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1.2"
            android:background="@drawable/btn_quick_action"
            android:gravity="center"
            android:text="@string/timetable_btn_label"
            android:textColor="@color/quick_btn_text"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_nav_anatomy"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/btn_quick_action"
            android:gravity="center"
            android:text="@string/anatomy_btn_label"
            android:textColor="@color/quick_btn_text"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/btn_nav_physio"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/btn_quick_action"
            android:gravity="center"
            android:text="@string/physio_btn_label"
            android:textColor="@color/quick_btn_text"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/btn_nav_biochem"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:background="@drawable/btn_quick_action"
            android:gravity="center"
            android:text="@string/biochem_btn_label"
            android:textColor="@color/quick_btn_text"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
